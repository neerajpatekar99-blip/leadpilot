# ================================================================
# LeadPilot Universal AI CRM - Environment Configuration
# ================================================================
# Copy this file to `.env.local` and fill in your client's credentials.

# --- 1. NEXT.JS PUBLIC CONFIGURATION ---
# Base URL of your deployed application or local environment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 2. GOOGLE CLOUD / FIREBASE DATABASE CONFIGURATION ---
# Found in Firebase Console -> Project Settings -> General
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Admin SDK Service Account Credentials
# Found in Firebase Console -> Project Settings -> Service Accounts -> "Generate New Private Key"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Note: Keep the exact private key including the BEGIN/END header and escaped newlines (\n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --- 3. GROQ AI ENGINE (Llama 3.3 70B & DeepSeek R1) ---
# Get free / high-speed production API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- 4. META WHATSAPP CLOUD API (Official Business API) ---
# Found in Meta for Developers -> App Dashboard -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=EAAG...your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_VERIFY_TOKEN=leadpilot_webhook_token
NEXT_PUBLIC_WHATSAPP_VERIFY_TOKEN=leadpilot_webhook_token

# Optional: Meta App Credentials for 1-Click Embedded Onboarding
NEXT_PUBLIC_META_APP_ID=your_meta_app_id_here
NEXT_PUBLIC_META_CONFIG_ID=your_meta_config_id_here
FACEBOOK_APP_SECRET=your_meta_app_secret_here

# --- 5. STANDALONE WHATSAPP GATEWAY (Baileys QR Linking - Optional) ---
# Used if running the background QR / pairing code link gateway (`npm run whatsapp:gateway`)
# Provide phone number with country code (e.g. 919876543210 for +91 98765 43210)
WHATSAPP_LINK_PHONE=
