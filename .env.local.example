# Firebase Configuration
# Found in Firebase Console -> Project Settings -> General -> Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin SDK Credentials
# Found in Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# WhatsApp API Credentials
# Found in Meta for Developers -> App Dashboard -> WhatsApp -> Getting Started
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Groq API Key
# Found in Groq Console -> API Keys
GROQ_API_KEY=

# Facebook/Meta Integration
# Found in Meta for Developers -> App Dashboard -> Settings -> Basic
FACEBOOK_APP_SECRET=
