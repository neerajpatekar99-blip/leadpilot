# ================================================================
# LeadPilot Production Environment Configuration
# ================================================================

# --- 1. NEXT.JS PUBLIC CONFIGURATION ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 2. GOOGLE CLOUD / FIREBASE DATABASE CONFIGURATION ---
# Found in Firebase Console -> Project Settings -> General
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Admin SDK Service Account Credentials
# Found in Firebase Console -> Project Settings -> Service Accounts -> "Generate New Private Key"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Note: Keep the exact private key including the BEGIN/END header and line breaks or \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --- 3. GROQ AI ENGINE (Llama 3.3 70B Versatile) ---
# Get free / production API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- 4. META WHATSAPP CLOUD API ---
# Found in Meta for Developers -> App Dashboard -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=EAAG...your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_VERIFY_TOKEN=leadpilot_webhook_token

# --- 5. FACEBOOK / META LEAD ADS INTEGRATION ---
# Found in Meta for Developers -> App Dashboard -> App Settings -> Basic -> App Secret
FACEBOOK_APP_SECRET=your_meta_app_secret_here
